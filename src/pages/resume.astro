---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { education, experience, skills, languages, profile, url } from '../data/site';

const groups = [
  { title: 'Professional Skills', items: skills },
  { title: 'Languages', items: languages },
];
---
<Base title="Resume">
  <PageHeader title="Resume" />

  <div class="container-site relative z-10 grid gap-20 pb-32">
    <!-- Experience -->
    {(experience.length > 0 || profile.resumePdf) && (
      <section>
        <div class="mb-6 flex items-center justify-between gap-4">
          <h2 data-reveal class="heading-card">Experience</h2>
          {profile.resumePdf && (
            <a href={url(profile.resumePdf)} target="_blank" rel="noopener" class="btn-pill h-12 px-6 text-[15px]">
              <Icon name="download" /> Download Resume
            </a>
          )}
        </div>
        <div class="grid gap-5">
          {experience.map((e) => (
            <div data-reveal class="card grid gap-6 p-7 sm:p-10 md:grid-cols-[260px_1fr]">
              <div class="rounded-[24px] p-6" style="background: rgb(255 255 255 / 0.04)">
                <p class="text-[14px] text-accent-soft">{e.period}</p>
                <p class="mt-2 text-fg">{e.role}</p>
                <p class="text-[14px] text-fg-subtle">{e.org}</p>
              </div>
              <ul class="space-y-2 self-center text-[15px] leading-[1.75] text-fg-muted">
                {e.points.map((pt) => <li class="flex gap-3"><span class="mt-[11px] size-1 shrink-0 rounded-full bg-accent-soft" />{pt}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Education -->
    <section>
      <h2 data-reveal class="heading-card mb-6">Education</h2>
      <div class="grid gap-5">
        {education.map((e) => (
          <div data-reveal class="card grid gap-6 p-7 sm:p-10 md:grid-cols-[260px_1fr] md:gap-10">
            <div class="rounded-[24px] p-6" style="background: rgb(255 255 255 / 0.04); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.04)">
              <p class="text-[14px] text-accent-soft">{e.period}</p>
              <p class="mt-3 text-[17px] text-fg">{e.school}</p>
              <p class="text-[14px] text-fg-subtle">{e.location}</p>
              <div class="mt-3 text-[14px] text-fg-muted italic">
                {e.dept.map((d) => <p>{d}</p>)}
              </div>
            </div>
            <ul class="space-y-2.5 self-center text-[15px] leading-[1.75] text-fg-muted sm:text-[16px]">
              {e.points.map((pt) => <li class="flex gap-3"><span class="mt-[12px] size-1 shrink-0 rounded-full bg-accent-soft" />{pt}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section data-reveal class="card grid gap-12 p-7 sm:p-10">
      {groups.map((g) => (
        <div>
          <h2 class="heading-card mb-6">{g.title}</h2>
          <ul class="grid grid-cols-2 gap-3 md:grid-cols-3">
            {g.items.map((s) => (
              <li class="rounded-[20px] px-5 py-4 text-[15px] text-fg" style="background: rgb(255 255 255 / 0.04); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05)">{s}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</Base>
