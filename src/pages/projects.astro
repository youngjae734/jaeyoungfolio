---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Glow from '../components/Glow.astro';
import Icon from '../components/Icon.astro';
import { projects, url } from '../data/site';
---
<Base title="Projects">
  <PageHeader title="Projects" />

  <section class="relative z-10 pb-24">
    <div class="container-site grid gap-5">
      {projects.map((p) => (
        <a
          data-reveal
          id={p.slug}
          href={url(p.pdf)}
          target="_blank"
          rel="noopener"
          class="card group grid scroll-mt-28 overflow-hidden transition hover:bg-card-hover md:grid-cols-[1fr_340px]"
        >
          <div class="flex flex-col p-7 sm:p-10">
            <p class="label">{p.label}</p>
            <h2 class="heading-card mt-2">{p.title}</h2>
            <div class="mt-5 space-y-4 text-[15px] leading-[1.8] text-fg-muted sm:text-[16px] [&_strong]:font-semibold [&_strong]:text-fg">
              {p.body.map((para) => <p set:html={para} />)}
            </div>
            <span class="mt-8 inline-flex items-center gap-2 text-[14px] text-fg-muted transition group-hover:text-fg">
              <span class="icon-circle group-hover:bg-accent group-hover:text-white"><Icon name="file" /></span>
              발표 자료 보기 (PDF)
            </span>
          </div>
          <div class="relative min-h-[340px] overflow-hidden">
            <div
              class="absolute inset-x-6 top-0 -bottom-6 overflow-hidden rounded-t-[20px] transition duration-500 group-hover:-translate-y-2 md:inset-x-0 md:top-10 md:right-10 md:bottom-0 md:rounded-[20px]"
              style="box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08), 0 30px 60px rgb(0 0 0 / 0.5);"
            >
              <Image src={p.image} alt={p.imageAlt} class="size-full object-cover object-top" widths={[340, 680]} sizes="(min-width: 768px) 300px, 90vw" />
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="relative flex min-h-[520px] items-center justify-center pt-16 pb-40 text-center">
    <Glow position="bottom" />
    <div class="container-site relative z-10">
      <h2 data-reveal class="heading-section">Let's create world together</h2>
      <div data-reveal="0.1" class="mt-10">
        <a href={url('contact')} class="btn-pill w-[200px]">Contact me</a>
      </div>
    </div>
  </section>
</Base>
