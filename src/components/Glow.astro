---
// 레퍼런스의 상단/하단 보라색 원 + 은은한 광원 + 세로 라인
interface Props { position?: 'top' | 'bottom'; class?: string }
const { position = 'top', class: cls = '' } = Astro.props;
const top = position === 'top';
---
<div class:list={['pointer-events-none absolute inset-x-0 overflow-hidden', top ? 'top-0 h-[900px]' : 'bottom-0 h-[700px]', cls]} aria-hidden="true">
  <!-- radial glow -->
  <div
    class="absolute inset-0"
    style={top
      ? 'background: radial-gradient(60% 70% at 50% 0%, rgb(var(--accent-rgb) / 0.55) 0%, rgb(var(--accent-rgb) / 0.35) 40%, transparent 75%)'
      : 'background: radial-gradient(55% 75% at 50% 100%, rgb(var(--accent-rgb) / 0.5) 0%, rgb(var(--accent-rgb) / 0.3) 40%, transparent 75%)'}
  ></div>
  <!-- vertical lines -->
  <div
    class="absolute inset-0 opacity-60"
    style={`background-image: repeating-linear-gradient(90deg, transparent 0 142px, rgb(var(--fg-rgb) / 0.05) 142px 143px); mask-image: linear-gradient(${top ? '180deg' : '0deg'}, black 10%, transparent 70%); -webkit-mask-image: linear-gradient(${top ? '180deg' : '0deg'}, black 10%, transparent 70%);`}
  ></div>
  <!-- disk -->
  <div
    class:list={['absolute left-1/2 size-[280px] -translate-x-1/2 rounded-full sm:size-[400px]', top ? '-top-[190px] sm:-top-[280px]' : '-bottom-[190px] sm:-bottom-[280px]']}
    style="background: radial-gradient(circle at 50% 50%, var(--accent) 0%, var(--accent) 60%, var(--accent) 100%); box-shadow: 0 0 120px 20px rgb(var(--accent-rgb) / 0.45);"
  ></div>
</div>
