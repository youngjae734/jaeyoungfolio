---
import { url } from '../data/site';
const links = [
  { href: '', label: 'Home' },
  { href: 'projects', label: 'Projects' },
  { href: 'resume', label: 'Resume' },
  { href: 'contact', label: 'Contact' },
];
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/^\/|\/$/g, '');
---
<nav class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
  <ul
    class="flex items-center gap-1 rounded-full p-1.5 text-[14px] backdrop-blur-xl"
    style="background: rgb(20 20 20 / 0.7); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08), 0 8px 32px rgb(0 0 0 / 0.4);"
  >
    {links.map((l) => {
      const active = current === l.href;
      return (
        <li>
          <a
            href={url(l.href)}
            class:list={['block rounded-full px-3.5 py-2 transition sm:px-4', active ? 'bg-white/10 text-fg' : 'text-fg-muted hover:text-fg']}
            aria-current={active ? 'page' : undefined}
          >{l.label}</a>
        </li>
      );
    })}
  </ul>
</nav>
