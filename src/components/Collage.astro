---
// 홈 프로젝트 카드용 콜라주: 큰 슬라이드 2장(반투명) 위에 그래프 카드 2장을 겹쳐 보여줍니다.
//  · 위 슬라이드는 카드 왼쪽 끝에, 아래 슬라이드는 카드 오른쪽 끝에 붙어서 잘려 보입니다.
//  · 위치/크기는 아래 style의 % 값으로 조절합니다. (콜라주 영역 전체 = 100%)
//  · 슬라이드 투명도는 .collage-slide 의 opacity 값으로 조절합니다.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slides: [ImageMetadata, ImageMetadata];
  graphs: [ImageMetadata, ImageMetadata];
  alt: string;
}
const { slides, graphs, alt } = Astro.props;
---
<div class="collage relative w-full" aria-label={alt} role="img">
  <!-- 위 슬라이드: 왼쪽 끝에 붙음 -->
  <Image src={slides[0]} alt="" class="collage-slide" style="left: 0; top: 4%; width: 93%;" widths={[500, 1000]} sizes="(min-width: 768px) 460px, 90vw" />
  <!-- 위 그래프 카드 -->
  <Image src={graphs[0]} alt="" class="collage-graph" style="left: 54%; top: 0; width: 34%;" widths={[240, 480]} sizes="(min-width: 768px) 170px, 34vw" />
  <!-- 아래 슬라이드: 오른쪽 끝에 붙음 -->
  <Image src={slides[1]} alt="" class="collage-slide" style="right: 0; top: 59%; width: 83%;" widths={[500, 1000]} sizes="(min-width: 768px) 410px, 85vw" />
  <!-- 아래 그래프 카드 -->
  <Image src={graphs[1]} alt="" class="collage-graph" style="left: 30%; top: 66%; width: 48%;" widths={[300, 600]} sizes="(min-width: 768px) 240px, 48vw" />
</div>

<style>
  /* 콜라주 영역의 가로:세로 비율 (세로를 늘리면 위아래 간격이 넓어짐) */
  .collage { aspect-ratio: 348 / 450; }
  .collage :global(img) { position: absolute; height: auto; }
  .collage :global(.collage-slide) { opacity: 0.6; }
  .collage :global(.collage-graph) { transition: translate 0.5s; }
  :global(.group:hover) .collage :global(.collage-graph) { translate: 0 -8px; }
</style>
